# ============================================
# Linux 빌드 환경
# ============================================
# 글로벌 linux 빌드 디렉토리 설정 (기본값: build/linux)
# 설정하지 않으면 프로젝트 루트에서 Makefile 검색
[linux]
# linux_dir = "build/linux"  # 또는 빈 문자열("")로 설정하면 프로젝트 루트 검색

[[linux.env]]
name = "x64"

[[linux.env]]
name = "tcc803x-3.1.0-a53hf-arm32"
platform_id = "a53hf-arm32-tcc803x"
env_script = "/mnt/share/toolchain/tcc803x-3.1.0-a53hf-arm32/environment-setup-cortexa53hf-neon-fp-armv8-telechips-linux-gnueabi"

[[linux.env]]
name = "tcc803x-3.2.0-a7hf-arm32"
platform_id = "a7hf-arm32-tcc803x"
env_script  = "/mnt/share/toolchain/tcc803x-3.2.0-a7hf-arm32/environment-setup-cortexa7hf-neon-telechips-linux-gnueabi"

[[linux.env]]
name = "tcc803x-yp4.0-a53-aarch64"
platform_id = "a53-aarch64-tcc803x"
env_script = "/mnt/share/toolchain/tcc803x-yp4.0-a53-aarch64/environment-setup-cortexa53-telechips-linux"

[[linux.env]]
name = "rk3568"
platform_id = "a55-aarch64-rk3568"
use_pkg_config = 1
env_script  = "/mnt/share/toolchain/rk3568-sdk14/environment-setup"

[[linux.env]]
name = "tcc807x-1.0.0-a55-subcore"
platform_id = "a55-aarch64-tcc807x"
env_script  = "/mnt/share/toolchain/oecore-x86_64/environment-setup-cortexa55-telechips-linux"

[[linux.env]]
name = "tcc807x-evm"
platform_id = "a55-aarch64-tcc807x-evm"
env_script  = "/mnt/temp/toolchain/d5-adt/environment-setup-cortexa55-telechips-linux"

[[linux.env]]
name = "rk3576"
platform_id = "a53-aarch64-rk3576"
env_script  = "/mnt/share/toolchain/rk3576-eyel-s3000abr-vulkan/environment-setup"


# ============================================
# Visual Studio 빌드 설정
# ============================================
[msbuild]
command        = "C:/Program Files/Microsoft Visual Studio/2022/Community/MSBuild/Current/Bin/amd64/MSBuild.exe"
configurations = ["Debug", "Release"]
# 글로벌 VS 빌드 디렉토리 설정 (기본값: build/vs)
# 설정하지 않으면 프로젝트 루트에서 .sln 검색
# vs_dir = "build/vs"  # 또는 빈 문자열("")로 설정하면 프로젝트 루트 검색

# ============================================
# 빌드할 프로젝트 목록
# ============================================
[[project]]
path = "lbx-core"

[[project]]
path = "lbx-intf"

[[project]]
path = "lbx-cal"

[[project]]
path = "lbx-geo"

[[project]]
path = "lbx-gfx"

[[project]]
path = "lbx-gl"

[[project]]
path = "lbx-gui"

[[project]]
path = "drv/avio-file"

[[project]]
path = "drv/avio-v4l2"

[[project]]
path = "drv/plat-glfb"
skip = ["x64", "rk3568", "rk3576"]

[[project]]
path = "drv/plat-glwl"
skip = ["tcc803x-3.1.0-a53hf-arm32", "tcc803x-3.2.0-a7hf-arm32", "tcc803x-yp4.0-a53-aarch64", "tcc807x-1.0.0-a55-subcore", "tcc807x-evm"]

[[project]]
path = "drv/plat-glwin"

[[project]]
path = "drv/plat-vkwin"

[[project]]
path = "drv/plat-vkwl"
skip = ["tcc803x-3.1.0-a53hf-arm32", "tcc803x-3.2.0-a7hf-arm32", "tcc803x-yp4.0-a53-aarch64", "tcc807x-1.0.0-a55-subcore", "tcc807x-evm"]

[[project]]
path = "cal/cal-flood"

[[project]]
path = "lbsvm-core"

[[project]]
path = "eyel2sdk"
linux_dir = "examples/build/linux"

# 특정 프로젝트만 다른 빌드 디렉토리를 사용하려면:
# [[project]]
# path = "special-project"
# vs_dir = "custom/vs"        # 이 프로젝트만 custom/vs 폴더 사용
# linux_dir = "custom/linux"  # 이 프로젝트만 custom/linux 폴더 사용

# 특정 프로젝트의 루트에서 검색하려면:
# [[project]]
# path = "another-project"
# vs_dir = ""      # 빈 문자열로 설정하면 프로젝트 루트에서 .sln 검색
# linux_dir = ""   # 빈 문자열로 설정하면 프로젝트 루트에서 Makefile 검색

# ============================================
# Deploy 설정
# ============================================
[deploy]
command = "lit deploy --silent"

# ============================================
# 릴리스 번들 태그 (lit-build --release → lit-bundle)
# ============================================
# 릴리스 sweep 종료 후, gate 프로젝트가 green 빌드되면(통합 검증) gate 의 서브모듈
# (=실제로 함께 동작 검증된 그 조합)에 번들 태그를 건다. 태그 annotation 에는 모듈
# 버전 + 실제 링크 의존(매니페스트)이 들어간다. version_from 모듈의 dll 버전을 태그
# 버전으로 사용한다(MAJOR.MINOR.PATCH). gate/version_from 이 빌드에서 빠지면 생략.
[release]
gate = "eyel2sdk"

[[release.bundle]]
target = "lib/lbx"
version_from = "lbx-core"

[[release.bundle]]
target = "lib/lbsvm"
version_from = "lbsvm-core"
